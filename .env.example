# LifeDrop Environment Configuration Example
# Copy this file to .env and adjust variables as needed

SECRET_KEY=replace-with-a-secure-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional Database Configuration (Defaults to SQLite if DB_ENGINE is empty)
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Security Flags for Production (Set to True in HTTPS production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
